<!-- datos.dtd
     Valida la estructura de datos.xml para el catálogo de videojuegos -->

<!ELEMENT catalogo (juego+)>

<!ELEMENT juego (titulo, desarrollador, anio, genero, plataforma, precio, calificacion, descripcion)>
<!ATTLIST juego id ID #REQUIRED>

<!ELEMENT titulo (#PCDATA)>
<!ELEMENT desarrollador (#PCDATA)>
<!ELEMENT anio (#PCDATA)>
<!ELEMENT genero (#PCDATA)>
<!ELEMENT plataforma (#PCDATA)>
<!ELEMENT precio (#PCDATA)>
<!ELEMENT calificacion (#PCDATA)>
<!ELEMENT descripcion (#PCDATA)>
